///|
extern "js" fn read_project_file(path : String) -> String =
  #|(path) => process.getBuiltinModule("fs").readFileSync(path, "utf8")

///|
fn embedded_fixture_source(fixtures : String) -> String {
  let source = StringBuilder()
  source.write_string("///|\n")
  source.write_string(
    "// Generated from upstream Yjs by scripts/yjs-fixtures.mbtx.\n",
  )
  source.write_string("const YJS_FIXTURE_JSONL : String =\n")
  for line in fixtures.split("\n") {
    if !line.is_empty() {
      source.write_string("  #|")
      source.write_string(line.to_owned())
      source.write_char('\n')
    }
  }
  source.write_string("// End generated Yjs fixture data.\n")
  source.to_string()
}

///|
fn check_fixture_copies(fixtures : String) -> Unit raise {
  let checked_in_fixtures = read_project_file("compat/yjs/fixtures.jsonl")
  if checked_in_fixtures != "\{fixtures}\n" {
    fail("compat/yjs/fixtures.jsonl is out of date; regenerate it from Yjs")
  }
  let test_source = read_project_file("compatibility_test.mbt")
  let embedded = embedded_fixture_source(fixtures)
  if !test_source.contains(embedded) {
    fail(
      "compatibility_test.mbt fixture data is out of date; refresh its generated block",
    )
  }
  println("upstream fixture data and embedded black-box data match")
}

///|
fn main raise {
  let fixtures = yjs_fixtures()
  let args = @env.args()
  let mut moonbit_mode = false
  let mut check_mode = false
  for arg in args {
    if arg == "--moonbit" {
      moonbit_mode = true
    } else if arg == "--check" {
      check_mode = true
    }
  }
  if moonbit_mode {
    println(embedded_fixture_source(fixtures))
  } else if check_mode {
    check_fixture_copies(fixtures)
  } else {
    println(fixtures)
  }
}
